# ── AI (free tiers) ─────────────────────────────────────────────
GOOGLE_AI_API_KEY=              # required: Gemini Flash / Flash-Lite / Gemma 4 (aistudio.google.com/apikey)
# GOOGLE_AI_API_KEY_2=          # more keys from other Google Cloud projects = more free capacity (_2 … _9)
GROQ_API_KEY=                   # console.groq.com/keys
OPENROUTER_API_KEY=             # openrouter.ai/keys
CLOUDFLARE_API_TOKEN=           # Workers AI: AI images (schnell / FLUX.2 klein 4B) + backup text model
CLOUDFLARE_ACCOUNT_ID=
OPENALEX_API_KEY=               # optional, scholarly search
BENCHMARK_PASSWORD=             # optional, enables /benchmark

# ── Site ─────────────────────────────────────────────────────────
APP_SECRET=                     # required: long random string (signs download/preview links)
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_PER_OWNER=3
# DECKCRAFT_DATA_DIR=./.data

# ── Supabase: Google login + durable storage ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # secret, server only
# REQUIRE_LOGIN=true

# ── Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=                # rzp_test_… for test mode
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PRICE_DECK_INR=39
# PRICE_FIRST_DECK_INR=9
# PRICE_PACK5_INR=149
# REFERRAL_CREDITS=1
# FREE_EDITS_PER_DECK=2
# PAYMENTS_PROVIDER=mock        # local testing only

# ── Tuning (optional) ────────────────────────────────────────────
# ENGINE_V3_ROUTES='{"design":["google:gemini-3.8-flash","groq:openai/gpt-oss-120b"]}'
# V3_VISION_QA=smart            # smart | always | off
# V3_MAX_REVISIONS=2
# V3_MAX_CAPACITY_WAIT_MIN=20
# V3_ACCOUNT_OPENROUTER_RPD=1000
# CUSTOM_LLM_BASE_URL= CUSTOM_LLM_API_KEY=   any OpenAI-compatible provider ("custom" in routes)
