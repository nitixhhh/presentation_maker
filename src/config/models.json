{
  "providers": {
    "google": {
      "name": "Google AI Studio",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiKeyEnv": "GOOGLE_AI_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 4,
      "dailyReset": "pacific-midnight",
      "accountLimits": {},
      "limits": {
        "rpm": 15,
        "rpd": 1500,
        "tokensPerDay": 1000000
      },
      "tpmInputOnly": true
    },
    "groq": {
      "name": "GroqCloud",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 3,
      "dailyReset": "rolling",
      "accountLimits": {},
      "limits": {
        "rpm": 30,
        "rpd": 14400,
        "tokensPerDay": 500000
      }
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_NIM_API_KEY",
      "enabled": false,
      "allowedForProduction": false,
      "limits": {
        "rpm": 10,
        "rpd": 1000,
        "tokensPerDay": 300000
      }
    },
    "cloudflare": {
      "name": "Cloudflare Workers AI",
      "baseUrl": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN",
      "accountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 3,
      "dailyReset": "utc-midnight",
      "accountLimits": {
        "tpd": 180000
      },
      "_note": "Free: 10,000 Neurons/day shared by all models (resets 00:00 UTC). tpd is an approximation of that budget in tokens for gpt-oss-120b; the daily-limit error is also detected.",
      "limits": {
        "rpm": 20,
        "rpd": 2000,
        "neuronsPerDay": 10000
      }
    },
    "openrouter": {
      "name": "OpenRouter (Free Tier)",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 2,
      "dailyReset": "utc-midnight",
      "accountLimits": {
        "rpm": 20,
        "rpd": 50
      },
      "_note": "Free models: 20 requests/min and 50 requests/day per account; 1000/day once you have bought at least $10 of credits ever (set V3_ACCOUNT_OPENROUTER_RPD=1000).",
      "limits": {
        "rpm": 20,
        "rpd": 200,
        "tokensPerDay": 200000
      }
    },
    "custom": {
      "name": "Any OpenAI-compatible provider (optional)",
      "baseUrl": "",
      "baseUrlEnv": "CUSTOM_LLM_BASE_URL",
      "apiKeyEnv": "CUSTOM_LLM_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 6,
      "limits": {
        "rpm": 30,
        "rpd": 10000,
        "tokensPerDay": 2000000
      }
    }
  },
  "agents": {
    "Owner": {
      "primary": {
        "provider": "google",
        "model": "gemini-2.5-flash"
      },
      "fallbacks": [
        {
          "provider": "groq",
          "model": "openai/gpt-oss-120b"
        }
      ]
    },
    "Researcher": {
      "primary": {
        "provider": "google",
        "model": "gemini-2.5-flash"
      },
      "fallbacks": [
        {
          "provider": "groq",
          "model": "openai/gpt-oss-120b"
        }
      ]
    },
    "SlideWriter": {
      "primary": {
        "provider": "google",
        "model": "gemini-2.5-flash"
      },
      "fallbacks": [
        {
          "provider": "groq",
          "model": "openai/gpt-oss-120b"
        }
      ]
    },
    "ArtDirector": {
      "primary": {
        "provider": "google",
        "model": "gemini-2.5-flash"
      },
      "fallbacks": [
        {
          "provider": "groq",
          "model": "openai/gpt-oss-120b"
        }
      ]
    },
    "DiagramCodeSpecialist": {
      "primary": {
        "provider": "groq",
        "model": "openai/gpt-oss-120b"
      },
      "fallbacks": [
        {
          "provider": "google",
          "model": "gemini-2.5-flash"
        }
      ]
    },
    "ImagePromptWriter": {
      "primary": {
        "provider": "groq",
        "model": "openai/gpt-oss-20b"
      },
      "fallbacks": [
        {
          "provider": "google",
          "model": "gemini-2.5-flash"
        }
      ]
    },
    "VisionQA": {
      "primary": {
        "provider": "google",
        "model": "gemini-2.5-flash"
      },
      "fallbacks": [
        {
          "provider": "groq",
          "model": "openai/gpt-oss-120b"
        }
      ]
    },
    "ImageGenerator": {
      "primary": {
        "provider": "cloudflare",
        "model": "@cf/black-forest-labs/flux-1-schnell"
      },
      "fallbacks": [
        {
          "provider": "unsplash",
          "model": "stock-api"
        }
      ]
    }
  },
