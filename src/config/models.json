{
  "providers": {
    "google": {
      "name": "Google AI Studio",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "apiKeyEnv": "GOOGLE_AI_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 4,
      "dailyReset": "pacific-midnight",
      "accountLimits": {},
      "limits": {
        "rpm": 15,
        "rpd": 1500,
        "tokensPerDay": 1000000
      },
      "tpmInputOnly": true
    },
    "groq": {
      "name": "GroqCloud",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 3,
      "dailyReset": "rolling",
      "accountLimits": {},
      "limits": {
        "rpm": 30,
        "rpd": 14400,
        "tokensPerDay": 500000
      },
      "firstByteMs": 30000,
      "idleMs": 30000,
      "timeoutMs": 90000,
      "_note": "Free plan (no card): openai/gpt-oss-120b 30 RPM, 1K RPD, 8K TPM (input+output of one request), 200K TPD (console.groq.com/docs/rate-limits, 31 Oct 2026). 8K TPM means big design calls cannot run here; used for light roles."
    },
    "nvidia": {
      "name": "NVIDIA NIM (build.nvidia.com) — BENCHMARK ONLY",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_NIM_API_KEY",
      "enabled": true,
      "allowedForProduction": false,
      "limits": {
        "rpm": 35,
        "rpd": 5000,
        "tokensPerDay": 3000000
      },
      "benchmarkOnly": true,
      "note": "testing only (NVIDIA trial terms)",
      "concurrency": 2,
      "dailyReset": "rolling",
      "_note": "NVIDIA API Trial Terms of Service (v. 19 Sep 2025) §1.4: without a paid subscription the API may be used 'only ... for internal testing and evaluation purposes, not in production'. So the engine NEVER routes production jobs here; these models appear only on /benchmark. NVIDIA no longer uses credits; per-model rate limits are not published (shown at the top right of build.nvidia.com; users report ~40 requests/min). Exception: ALLOW_NVIDIA_PRODUCTION=true (owner's own decision and risk) adds them to production routes via engineV3.optInRoutes.nvidia. 31 Oct 2026 probe: mistral-large-4-1t-a52b and glm-5.3-flash now think before answering and are very slow on the free queue (no first byte in 200 s on a design-sized prompt; glm ~50 s even for 'Say OK'), so they were removed from production routes; nemotron-3.5-super-vl needs chat_template_kwargs.enable_thinking=false or it returns only thinking.",
      "firstByteMs": 60000,
      "idleMs": 90000
    },
    "cloudflare": {
      "name": "Cloudflare Workers AI",
      "baseUrl": "https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1",
      "apiKeyEnv": "CLOUDFLARE_API_TOKEN",
      "accountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 3,
      "dailyReset": "utc-midnight",
      "accountLimits": {
        "tpd": 180000
      },
      "_note": "Free: 10,000 Neurons/day shared by all models (resets 00:00 UTC). tpd is an approximation of that budget in tokens for gpt-oss-120b; the daily-limit error is also detected.",
      "limits": {
        "rpm": 20,
        "rpd": 2000,
        "neuronsPerDay": 10000
      },
      "firstByteMs": 45000,
      "idleMs": 45000
    },
    "openrouter": {
      "name": "OpenRouter (Free Tier)",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 2,
      "dailyReset": "utc-midnight",
      "accountLimits": {
        "rpm": 20,
        "rpd": 50
      },
      "_note": "Free models: 20 requests/min and 50 requests/day per account; 1000/day once you have bought at least $10 of credits ever (set V3_ACCOUNT_OPENROUTER_RPD=1000).",
      "limits": {
        "rpm": 20,
        "rpd": 200,
        "tokensPerDay": 200000
      },
      "firstByteMs": 60000,
      "idleMs": 60000
    },
    "ollama": {
      "name": "Ollama Cloud (pay per token)",
      "baseUrl": "https://ollama.com/v1",
      "apiKeyEnv": "OLLAMA_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 3,
      "dailyReset": "rolling",
      "_note": "ollama.com hosted models through an API key, no own server (docs.ollama.com/cloud; OpenAI-compatible at https://ollama.com/v1). NOT free: 'Pay as you go — Pay per token for every cloud model' (ollama.com/pricing, 31 Oct 2026); 3 concurrent requests on pay-as-you-go. One account per person. Only used when OLLAMA_API_KEY is set; OLLAMA_PRIORITY=last moves it to the end of every chain.",
      "limits": {
        "rpm": 60,
        "rpd": 100000,
        "tokensPerDay": 50000000
      }
    },
    "custom": {
      "name": "Any OpenAI-compatible provider (optional)",
      "baseUrl": "",
      "baseUrlEnv": "CUSTOM_LLM_BASE_URL",
      "apiKeyEnv": "CUSTOM_LLM_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 6,
      "limits": {
        "rpm": 30,
        "rpd": 10000,
        "tokensPerDay": 2000000
      }
    },
    "mistral": {
      "name": "Mistral La Plateforme (Free mode)",
      "baseUrl": "https://api.mistral.ai/v1",
      "apiKeyEnv": "MISTRAL_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 2,
      "dailyReset": "rolling",
      "firstByteMs": 45000,
      "idleMs": 60000,
      "_note": "Free mode: 'API access is enabled by default with no credit card required. Usage and rate limits apply.' (docs.mistral.ai, read 31 Oct 2026). Per-model limits are shown only on admin.mistral.ai Limits page (not public) — the router learns them from 429s. Free mode may use inputs/outputs for training unless the account opts out (Data & Account Controls). Only used when MISTRAL_API_KEY is set.",
      "limits": {}
    },
    "sambanova": {
      "name": "SambaNova Cloud (free tier)",
      "baseUrl": "https://api.sambanova.ai/v1",
      "apiKeyEnv": "SAMBANOVA_API_KEY",
      "enabled": true,
      "allowedForProduction": true,
      "concurrency": 2,
      "dailyReset": "rolling",
      "firstByteMs": 45000,
      "idleMs": 45000,
      "timeoutMs": 180000,
      "_note": "Free tier = no payment method linked. Per model: 20 RPM, 20 requests/day, 200,000 tokens/day (docs.sambanova.ai/docs/en/models/rate-limits, 31 Oct 2026). Small daily budget: a backup, not a main route. Only used when SAMBANOVA_API_KEY is set.",
      "limits": {
        "rpm": 20,
        "rpd": 20,
        "tokensPerDay": 200000
      }
    }
  },
